# ==============================================================================
# FarmTrace Docker Environment Variables
# ==============================================================================

# Node.js Application
PORT=3000
NODE_ENV=development
TRACE_HMAC_SECRET_KEY=farmtrace-dev-hmac-master-key-32bytes-secret
FRONTEND_URL=http://localhost:3000

# PostgreSQL (PostGIS)
POSTGRES_DB=farmtrace_db
POSTGRES_USER=farmtrace_user
POSTGRES_PASSWORD=farmtrace_secure_pass_2026
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379
REDIS_PASSWORD=farmtrace_redis_secret_2026
